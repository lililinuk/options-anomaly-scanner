# Copy to .env. Never commit the real file.
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Use a local PostgreSQL database. Keep credentials out of source control.
DATABASE_URL=postgresql+psycopg://options_scanner:change-me@localhost:5432/options_scanner

# Server-side only. Never prefix this with NEXT_PUBLIC_.
NIGHTWATCH_API_KEY=
NIGHTWATCH_BASE_URL=https://api.yehangshe.com
NIGHTWATCH_TIMEOUT_SECONDS=20
NIGHTWATCH_MAX_RETRIES=3
NIGHTWATCH_MAX_CONCURRENCY=4
NIGHTWATCH_METADATA_REFRESH_SECONDS=900

# Production scheduling is deliberately disabled in Phase 1.
SCAN_SCHEDULE_ENABLED=false

# Browser-visible URL for our FastAPI service, never for Nightwatch.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
