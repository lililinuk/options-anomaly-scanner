# Copy to .env. Never commit the real file.
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Use a local PostgreSQL database. Keep credentials out of source control.
DATABASE_URL=postgresql+psycopg://options_scanner:change-me@localhost:5432/options_scanner
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Server-side only. Never prefix this with NEXT_PUBLIC_.
NIGHTWATCH_API_KEY=
NIGHTWATCH_BASE_URL=https://api.yehangshe.com
NIGHTWATCH_TIMEOUT_SECONDS=20
NIGHTWATCH_MAX_RETRIES=3
NIGHTWATCH_MAX_CONCURRENCY=4
NIGHTWATCH_METADATA_REFRESH_SECONDS=900

# Runtime-versioned server-side Radar material-event profile.
RADAR_THRESHOLD_PROFILE_ID=radar_material_event
RADAR_THRESHOLD_PROFILE_VERSION=2026-08-13.v1
RADAR_THRESHOLD_ENABLED=true
RADAR_MIN_PREMIUM_USD=150000
RADAR_MIN_ABS_OI_DIFF=2500
RADAR_CALIBRATION_REVIEW_SESSIONS=20

# Phase 2B v3.1 external-scheduler Dealer/GEX archive (non-secret settings).
DEALER_GEX_ARCHIVE_ENABLED=true
DEALER_GEX_ARCHIVE_CONFIG_VERSION=2026-08-14.v3.1
DEALER_GEX_ARCHIVE_LOCAL_TIME=15:30
DEALER_GEX_ARCHIVE_MAX_NETWORK_ATTEMPTS=7
DEALER_GEX_ARCHIVE_MAX_CONSUMED_UNITS=7

# Production scheduling is deliberately disabled in Phase 1.
SCAN_SCHEDULE_ENABLED=false

# Server-side Next.js proxy target for our FastAPI service, never Nightwatch.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
